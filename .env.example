# Supabase — Project Settings > API
#
# Nenhuma destas variáveis é um segredo, e nesta aplicação também nunca
# chegam ao browser: todo o acesso ao Supabase é feito no servidor. A
# segurança está nas políticas RLS da base de dados.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OPCIONAL — só para criar contas de utilizador a partir da aplicação.
#
# Esta chave CONTORNA todas as políticas de segurança da base de dados.
# Sem ela a aplicação funciona na íntegra; as contas criam-se no painel do
# Supabase, em Authentication > Users.
SUPABASE_SERVICE_ROLE_KEY=
