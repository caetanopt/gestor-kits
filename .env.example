# Supabase — Project Settings > API
#
# Nenhuma destas variáveis é um segredo, mas nesta aplicação também nunca
# chegam ao browser: todo o acesso ao Supabase é feito no servidor. A
# segurança está nas políticas RLS da base de dados.
#
# NÃO configure a chave service_role (nem a sb_secret_...): não é usada.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
